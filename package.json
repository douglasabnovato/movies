{
  "name": "movies",
  "version": "0.1.0",
  "private": true,
  "homepage": "https://douglasabnovato.github.io/movies",
  "dependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.30.6"
  },
  "scripts": {
    "start": "react-scripts start",
    "build": "react-scripts build",
    "test": "react-scripts test",
    "eject": "react-scripts eject",
    "lint": "eslint src --ext .js --max-warnings 0",
    "test:ci": "react-scripts test --watchAll=false --coverage",
    "format": "prettier --write",
    "prepare": "husky",
    "postbuild": "node scripts/inline-css.js && node scripts/home-snapshot.js",
    "test:scripts": "node --test scripts/home-snapshot.test.js"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^5.17.0",
    "@testing-library/react": "^13.4.0",
    "@testing-library/user-event": "^13.5.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.5.2",
    "prettier": "^3.9.10",
    "react-scripts": "^5.0.1"
  },
  "lint-staged": {
    "src/**/*.js": [
      "eslint --max-warnings 0",
      "prettier --write"
    ],
    "src/**/*.css": "prettier --write"
  },
  "jest": {
    "collectCoverageFrom": [
      "src/**/*.js",
      "!src/index.js"
    ],
    "coverageThreshold": {
      "global": {
        "statements": 85,
        "branches": 80,
        "functions": 80,
        "lines": 85
      }
    }
  },
  "engines": {
    "node": "20.x"
  }
}
